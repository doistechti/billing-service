# Database
DB_URL=jdbc:postgresql://SEU_HOST_POSTGRES:5432/billing_service
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha

# Internal API security
# Chave do merchant legacy (sistemas clientes anteriores)
INTERNAL_API_KEY=troque-por-uma-chave-forte
# Habilita /api/admin/merchants (cadastro de contas recebedoras)
ADMIN_API_KEY=troque-por-outra-chave-forte
# Obrigatoria: cifra as credenciais dos merchants. Gere com: openssl rand -base64 32
BILLING_ENCRYPTION_KEY=

# Mercado Pago
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_ACCESS_TOKEN=TEST-seu-access-token
MERCADO_PAGO_PUBLIC_KEY=TEST-sua-public-key
MERCADO_PAGO_WEBHOOK_SECRET=troque-pelo-webhook-secret
# true para usar sandbox_init_point no Checkout Pro do merchant legacy
MERCADO_PAGO_SANDBOX=false

# Public app URL used to generate Mercado Pago notification_url
APP_BASE_URL=https://seu-dominio.com

# Callbacks para os sistemas clientes
CALLBACKS_ENABLED=true

# App runtime
SERVER_PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75

# Pagar.me (opcional). As credenciais ficam por merchant, cifradas no banco.
# PAGAR_ME_BASE_URL=https://api.pagar.me/core/v5
